{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Ops Gateway",
    "summary": "A clean REST API over the Urja Meter Ops portal.",
    "description": "Exposes meter data, distribution-transformer information, GPS locations, and 30-minute consumption readings \u2014 all sourced from the Urja Meter Ops web portal via authenticated scraping. See **PROTOCOL.md** in the repository for a full description of how the portal works under the hood.",
    "contact": {
      "name": "Flock Energy Assignment",
      "url": "https://flockenergy.tech/"
    },
    "license": {
      "name": "Private"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health check",
        "description": "Returns the gateway health and whether the portal session is active.",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "List / search meters",
        "description": "Returns a paginated list of meters, optionally filtered by a search term.\n\nThe search matches against meter ID and serial number.  \nLeave `q` blank to list all meters (20 per page).",
        "operationId": "list_meters_v1_meters_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Search term \u2014 matches meter ID or serial number prefix",
              "default": "",
              "title": "Q"
            },
            "description": "Search term \u2014 matches meter ID or serial number prefix"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-based)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-based)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters/{meter_id}": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Get meter detail",
        "description": "Returns the full nameplate, hierarchy, and geo location for a single meter.\n\nUses the bulk-export endpoint (filtered client-side) which provides the\nrichest data for a single meter in one request.\n\n**Design note:** The export endpoint is signed and returns all 403 meters\nat once, so this call is O(1) in portal round-trips when the cache is warm.\nFor a production system with many concurrent callers you would add a local\nindex built from the bulk export; see PROTOCOL.md for details.",
        "operationId": "get_meter_v1_meters__meter_id__get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Meter ID, e.g. J100000",
              "title": "Meter Id"
            },
            "description": "Meter ID, e.g. J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters/{meter_id}/geo": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Get meter GPS location",
        "description": "Returns the latitude and longitude of the meter's installation point.",
        "operationId": "get_meter_geo_v1_meters__meter_id__geo_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Meter ID, e.g. J100000",
              "title": "Meter Id"
            },
            "description": "Meter ID, e.g. J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterGeoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meters/{meter_id}/consumption": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Get meter consumption readings",
        "description": "Returns 30-minute interval energy readings for the meter.\n\nFields per reading:\n- **timestamp** \u2014 local date/time string as returned by the portal\n- **kwh** \u2014 cumulative active energy (kWh)\n- **kvah** \u2014 cumulative apparent energy (kVAh)\n- **volt_r** \u2014 R-phase voltage (V)\n\nThe portal returns readings for the last ~24 hours by default.  \nThe number of readings and the time window are determined by the portal and\ncannot currently be changed via this gateway.",
        "operationId": "get_meter_consumption_v1_meters__meter_id__consumption_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Meter ID, e.g. J100000",
              "title": "Meter Id"
            },
            "description": "Meter ID, e.g. J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterConsumptionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/transformers": {
      "get": {
        "tags": [
          "transformers"
        ],
        "summary": "List distribution transformers",
        "description": "Returns a paginated list of distribution transformers (DTs).\n\nEach DT has a code, name, feeder code, and rated capacity in kVA.",
        "operationId": "list_transformers_v1_transformers_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-based)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-based)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DTListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/export": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Full meter export",
        "description": "Returns all meters for the requested page, including complete hierarchy\n(zone \u2192 circle \u2192 division \u2192 subdivision \u2192 substation \u2192 feeder \u2192 DT)\nand GPS coordinates.\n\nThis endpoint transparently handles HMAC signing of the portal's export\nendpoint \u2014 callers need no knowledge of the signing protocol.",
        "operationId": "bulk_export_v1_export_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-based, 20 meters per page)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-based, 20 meters per page)"
          }
        ],
        "responses": {
          "200": {
            "description": "All meters with full hierarchy and geo coordinates",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DTListResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/DistributionTransformer"
