            "type": "array",
            "title": "Data"
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        },
        "type": "object",
        "required": [
          "data",
          "pagination"
        ],
        "title": "DTListResponse"
      },
      "DistributionTransformer": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "feeder_code": {
            "type": "string",
            "title": "Feeder Code"
          },
          "capacity_kva": {
            "type": "integer",
            "title": "Capacity Kva"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "feeder_code",
          "capacity_kva"
        ],
        "title": "DistributionTransformer"
      },
      "EnergyReading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "kwh": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kwh"
          },
          "kvah": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kvah"
          },
          "volt_r": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volt R"
          }
        },
        "type": "object",
        "required": [
          "timestamp"
        ],
        "title": "EnergyReading"
      },
      "GeoLocation": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "title": "GeoLocation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "portal_authenticated": {
            "type": "boolean",
            "title": "Portal Authenticated"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "1.0.0"
          }
        },
        "type": "object",
        "required": [
          "status",
          "portal_authenticated"
        ],
        "title": "HealthResponse"
      },
      "HierarchyNode": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "title": "HierarchyNode"
      },
      "MeterConsumption": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/EnergyReading"
            },
            "type": "array",
            "title": "Readings"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "readings"
        ],
        "title": "MeterConsumption"
      },
      "MeterConsumptionResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MeterConsumption"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "MeterConsumptionResponse"
      },
      "MeterDetail": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id"
          },
          "serial_no": {
            "type": "string",
            "title": "Serial No"
          },
          "make": {
            "type": "string",
            "title": "Make"
          },
          "phase_type": {
            "type": "string",
            "title": "Phase Type"
          },
          "install_status": {
            "type": "string",
            "title": "Install Status"
          },
          "install_type": {
            "type": "string",
            "title": "Install Type"
          },
          "build": {
            "type": "string",
            "title": "Build"
          },
          "dt_code": {
            "type": "string",
            "title": "Dt Code"
          },
          "hierarchy": {
            "$ref": "#/components/schemas/MeterHierarchy"
          },
