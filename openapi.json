          "serial_no",
          "make",
          "phase_type",
          "install_status",
          "install_type",
          "build",
          "dt_code",
          "hierarchy"
        ],
        "title": "MeterDetail",
        "description": "Full meter record as returned by the export / detail endpoints."
      },
      "MeterDetailResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MeterDetail"
          }
        },
        "type": "object",
        "required": [
