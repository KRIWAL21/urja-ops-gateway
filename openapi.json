            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          }
        },
        "type": "object",
        "required": [
          "meter_id",
          "lat",
          "lng"
        ],
        "title": "MeterGeo"
      },
      "MeterGeoResponse": {
